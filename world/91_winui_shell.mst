    "── what the drain recorded ──────────────────────────────────────────"

    WinShell class >> drainPasses ^ <Integer> [ ^DrainPasses isNil ifTrue: [ 0 ] ifFalse: [ DrainPasses ] ]
    WinShell class >> layoutCount ^ <Integer> [ ^LayoutCount isNil ifTrue: [ 0 ] ifFalse: [ LayoutCount ] ]
    WinShell class >> lastLayoutSize ^ <Object> [ ^LastLayoutSize ]
    WinShell class >> pendingLayout ^ <Boolean> [ ^PendingLayout == true ]
    WinShell class >> notifyCount ^ <Integer> [ ^NotifyCount isNil ifTrue: [ 0 ] ifFalse: [ NotifyCount ] ]
    WinShell class >> lastNotify ^ <Object> [ ^LastNotify ]
    WinShell class >> trackEnterCount ^ <Integer> [ ^TrackEnterCount isNil ifTrue: [ 0 ] ifFalse: [ TrackEnterCount ] ]
    WinShell class >> trackExitCount ^ <Integer> [ ^TrackExitCount isNil ifTrue: [ 0 ] ifFalse: [ TrackExitCount ] ]
    WinShell class >> reaskCount ^ <Integer> [ ^ReaskCount isNil ifTrue: [ 0 ] ifFalse: [ ReaskCount ] ]
    WinShell class >> drainWorkCount ^ <Integer> [ ^DrainWorkCount isNil ifTrue: [ 0 ] ifFalse: [ DrainWorkCount ] ]
    WinShell class >> pendingCommandCount ^ <Integer> [
        ^PendingCommands isNil ifTrue: [ 0 ] ifFalse: [ PendingCommands size ] ]

    WinShell class >> askForAnotherPass [
        "Arm the 'work discovered during a pass' case (gate item 5)."
        ReaskOnce := true. ^self ]
    WinShell class >> raiseInNextPass [ DrainRaiseOnce := true. ^self ]
    WinShell class >> faultInNextPass [ DrainFaultOnce := true. ^self ]

    WinShell class >> lastLayoutMatchesClientRect ^ <Boolean> [
        "Gate item 2's assertion, written here so the script and the check
         cannot drift: what the DRAIN laid out against what the window IS. The
         two are read at different times from different sources, which is what
         makes it a cross-check rather than a tautology."
        LastLayoutSize isNil ifTrue: [ ^false ].
        self isOpen ifFalse: [ ^false ].
        ^(LastLayoutSize at: 1) = self clientWidth
            and: [ (LastLayoutSize at: 2) = self clientHeight ]
    ]

    WinShell class >> resetDrainCounters [
        DrainPasses := 0. PendingLayout := nil. LastLayoutSize := nil. LayoutCount := 0.
        PendingCommands := OrderedCollection new. PendingNotifies := OrderedCollection new.
        NotifyCount := 0. LastNotify := nil.
        TrackEnterCount := 0. TrackExitCount := 0.
        ReaskOnce := nil. ReaskCount := 0. DrainWorkCount := 0.
        DrainRaiseOnce := nil. DrainFaultOnce := nil.
        ^self
    ]

    WinShell class >> onKeyDown: wp <Integer> lParam: lp <Integer> ^ <Object> [
        "The editor and the shortcuts are WG5's. Defaulting is deliberate:
         swallowing keys here would break Alt-F4, the system menu and every
         accelerator Windows handles for free."
        LastKey := wp.
        ^#defwindowproc
    ]

    WinShell class >> onChar: wp <Integer> lParam: lp <Integer> ^ <Object> [
        LastKey := wp.
        ^#defwindowproc
    ]

    "── what the door recorded ───────────────────────────────────────────"

    WinShell class >> messagesSeen ^ <Integer> [ ^MessagesSeen isNil ifTrue: [ 0 ] ifFalse: [ MessagesSeen ] ]
    WinShell class >> lastMessage ^ <Object> [ ^LastMessage ]
    WinShell class >> lastSizeSeen ^ <Object> [ ^LastSizeSeen ]
    WinShell class >> sizeCount ^ <Integer> [ ^SizeCount isNil ifTrue: [ 0 ] ifFalse: [ SizeCount ] ]
    WinShell class >> closeCount ^ <Integer> [ ^CloseCount isNil ifTrue: [ 0 ] ifFalse: [ CloseCount ] ]
    WinShell class >> destroyCount ^ <Integer> [ ^DestroyCount isNil ifTrue: [ 0 ] ifFalse: [ DestroyCount ] ]
    WinShell class >> quitPosted ^ <Boolean> [ ^QuitPosted == true ]
    WinShell class >> lastKey ^ <Object> [ ^LastKey ]
    WinShell class >> lastCommand ^ <Object> [ ^LastCommand ]
    WinShell class >> nestedSendResult ^ <Object> [ ^NestedSendResult ]

    WinShell class >> lastSizeMatchesClientRect ^ <Boolean> [
        "The gate's item 2, written here so the script and the assertion cannot
         drift: what the MESSAGE said the client size became, against what
         GetClientRect says it is. Two independent sources, one equality."
        LastSizeSeen isNil ifTrue: [ ^false ].
        self isOpen ifFalse: [ ^false ].
        ^(LastSizeSeen at: 1) = self clientWidth
            and: [ (LastSizeSeen at: 2) = self clientHeight ]
    ]

    WinShell class >> resetDoorCounters [
        MessagesSeen := 0. LastMessage := nil. LastSizeSeen := nil.
        SizeCount := 0. CloseCount := 0. DestroyCount := 0.
        QuitPosted := nil. NestedSendResult := nil.
        LastKey := nil. LastCommand := nil.
        "WG3: the drain's tallies zero with the door's, because every gate line
         compares one against the other — `drainPasses < sizeCount` is
         meaningless if the two were reset at different moments."
        self resetDrainCounters.
        ^self
    ]

    "── D4: the three failure modes, armed from a script ─────────────────
     Not a debugging leftover. tests_wg2.md items 4-6 need a handler that
     raises, one that faults and one that nests, ON THE REAL WINDOW, with the
     real pump running — none of which can be arranged from outside this
     class, and all three of which have to be provably survivable before WG3
     puts anything a user cares about behind this door."

    WinShell class >> handlerMode: aSymbolOrNil <Object> [
        "#raise  — the handler raises a guest error before it does its work
         #fault  — the handler dereferences address 1: a real ACCESS_VIOLATION
         #nest   — the handler SendMessageW's its own window, re-entering the
                   wndproc on this thread while the door is already open
         nil     — behave"
        HandlerMode := aSymbolOrNil.
        ^self
    ]

    WinShell class >> handlerMode ^ <Object> [ ^HandlerMode ]

    WinShell class >> applyHandlerMode: aTag <Symbol> [
        "Run whatever failure the script armed, at the TOP of the handler, so
         the handler's own work is what does not happen. One-shot modes would
         hide the interesting question — 'does the NEXT message still get
         through' — so the mode persists until a script clears it."
        HandlerMode isNil ifTrue: [ ^self ].
        HandlerMode == #raise ifTrue: [
            ^self error: 'WinShell: deliberate raise inside the ' , aTag printString ,
                ' handler (tests_wg2.md item 4)' ].
        HandlerMode == #fault ifTrue: [
            "A wild dereference — P2's VEH catches it, its non-unwinding
             longjmp lands inside dispatch_callback, and the door's RAII depth
             guard is released on the way through. That last clause is the one
             this whole sprint is nervous about."
            ^(Alien forAddress: 1 size: 8) signedLongAt: 1 ].
        HandlerMode == #nest ifTrue: [
            "Re-enter the window proc from inside the door. Rust's depth guard
             is non-zero here, so the nested message is answered by
             DefWindowProcW and never reaches this class a second time — which
             is what `nestedSendResult` and the door's `nested` counter
             together prove."
            HandlerMode := nil.
            NestedSendResult := WinApi
                sendMessage: Hwnd
                message: (WinApi constant: 'WM_SIZE')
                wParam: 0
                lParam: 0.
            ^self ].
        ^self
    ]

    "── driving a resize from the guest ──────────────────────────────────"

    WinShell class >> resizeWindowTo: w <Integer> by: h <Integer> ^ <Boolean> [
        "Set the WINDOW rect (frame included) and let Win32 work out the
         client size, which is the number the WM_SIZE it provokes will carry.

         Δ (WG2, measured): calling this from a `gui doit` does NOT get the
         resize to Smalltalk, and tests_wg2.md item 2 says to do exactly that.
         SetWindowPos sends WM_SIZE SYNCHRONOUSLY, so from a doit the wndproc
         runs INSIDE `vm.exec` — a second top-level VM entry on a thread that
         already has one, sharing the one per-thread sigsetjmp slot. The door
         refuses it (`WinApi doorBusy`), which is correct and which means the
         message is DefWindowProcW's (the host marks the VM busy across every
         eval/exec and the door reads that before it reads anything else). The
         gate drives its resizes from the host's control drain instead, which
         is outside every VM entry — the
         same place Windows' own modal move/size loop calls SetWindowPos from
         when a user drags the frame. Kept here because it is the right home
         for the call and because WG3's layout code will want it."
        self ensureOpen: 'resizeWindowTo:by:'.
        ^WinApi asBool: (WinApi
            setWindowPos: Hwnd
            after: 0
            x: 0
            y: 0
            width: w
            height: h
            flags: ((WinApi constant: 'SWP_NOMOVE') bitOr: (WinApi constant: 'SWP_NOZORDER')))
    ]

    "── fault injection, for the gate's 'the loop outlives a fault' item ─"

    WinShell class >> faultMode: aSymbol <Symbol> [
        "#guest raises an ordinary Smalltalk error; #native dereferences
         address 1, which is a genuine access violation recovered by P2's
         VEH + non-unwinding longjmp. Both are injected at the END of
         `openMain`, so the window is fully real and fully shown when the
         VM falls over — which is the arrangement the gate needs: the pump
         must outlive the fault with a live window still in front of it."
        FaultMode := aSymbol.
        ^self
    ]

    WinShell class >> applyFaultInjection [
        FaultMode isNil ifTrue: [ ^self ].
        FaultMode == #guest ifTrue: [
            FaultMode := nil.
            ^self error: 'WinShell: deliberate guest fault inside openMain (MACVM_WINUI_FAULT)' ].
        FaultMode == #native ifTrue: [
            FaultMode := nil.
            ^(Alien forAddress: 1 size: 8) signedLongAt: 1 ].
        ^self
    ]

    "── reporting ────────────────────────────────────────────────────────"

    WinShell class >> report [
        "Every fact the sprint report has to state, in one doit. Written for
         a human reading a terminal and for a grep in a gate script; both
         audiences are real."
        Transcript showCr: 'WinShell:'.
        Transcript showCr: '  class          ' , self className.
        Transcript showCr: '  hwnd           16r' , (self hwndValue printString: 16).
        Transcript showCr: '  isWindow       ' , self isOpen printString.
        Transcript showCr: '  title          ' , (self isOpen ifTrue: [ self title ] ifFalse: [ '<none>' ]).
        Transcript showCr: '  dpi            ' , self dpi printString.
        Transcript showCr: '  client         ' , (self isOpen
            ifTrue: [ self clientWidth printString , 'x' , self clientHeight printString ]
            ifFalse: [ '<none>' ]).
        Transcript showCr: '  expected       ' , (self isOpen
            ifTrue: [ self expectedClientWidth printString , 'x' , self expectedClientHeight printString ]
            ifFalse: [ '<none>' ]).
        Transcript showCr: '  dark preferred ' , self darkMode printString ,
            ' (AppsUseLightTheme = ' , self appsUseLightTheme printString , ')'.
        Transcript showCr: '  mica HRESULT   ' , self micaHResult printString ,
            ' (' , self micaTook printString , ')'.
        Transcript showCr: '  dark HRESULT   ' , self darkHResult printString ,
            ' (' , self darkTitlebarTook printString , ')'.
        Transcript showCr: '  created on tid ' , self creatingThreadId printString.
        Transcript showCr: '  owned by tid   ' , (self isOpen
            ifTrue: [ self windowThreadId printString ] ifFalse: [ '<none>' ]).
        Transcript showCr: '  this tid       ' , WinApi currentThreadId printString.
        Transcript showCr: '  door address   16r' , (WinApi wndProcAddress printString: 16).
        Transcript showCr: '  messages seen  ' , self messagesSeen printString ,
            ' (size ' , self sizeCount printString ,
            ', close ' , self closeCount printString ,
            ', destroy ' , self destroyCount printString , ')'.
        Transcript showCr: '  last size seen ' , self lastSizeSeen printString.
        Transcript showCr: '  drain passes   ' , self drainPasses printString ,
            ' (layouts ' , self layoutCount printString ,
            ', notifies ' , self notifyCount printString ,
            ', work ' , self drainWorkCount printString , ')'.
        Transcript showCr: '  last layout    ' , self lastLayoutSize printString.
        Transcript showCr: '  heartbeat id   ' , self timerId printString ,
            ' every ' , self heartbeatMillis printString , 'ms'.
        Transcript showCr: '  controls       ' , self controlReport.
        ^self
    ]

    WinShell class >> controlReport ^ <String> [
        "Overridden by 92_winui_controls.mst. Without that file loaded there
         are no controls, and saying so is better than a blank line — the drain
         is a deliverable on its own and Part 1 of the gate runs with nothing
         in the window at all."
        ^'<none — 92_winui_controls.mst is not loaded>'
    ]

    WinShell class >> cycle: n <Integer> ^ <Dictionary> [
        "Open and destroy the window n times in one process (tests_wg1.md
         stress row 2). What this is really testing is that the class
         registration does not leak and that no HWND is handed back twice:
         RegisterClassW answers 0 from the second call on, and a shell that
         only ever opened once would pass in isolation and fail forever
         after — the exact trap WG0's own re-run pitfall laid for WG1.

         The window really is created and shown each time, because a hidden
         window would not exercise what WG1 changed."
        | handles usable |
        handles := Set new.
        usable := true.
        1 to: n do: [ :i |
            self openMain.
            handles add: self hwndValue.
            (WinApi classExists: self className) ifFalse: [ usable := false ].
            self destroyNow ].
        ^(Dictionary new)
            at: 'opened' put: n;
            at: 'distinctHandles' put: handles size;
            at: 'classUsableEveryTime' put: usable;
            at: 'stillRegistered' put: (WinApi classExists: self className);
            yourself
    ]
]
