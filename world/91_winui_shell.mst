    WinShell class >> buildDebuggerPane [ ^self ]
    WinShell class >> showDebuggerPane: aBool [ ^self ]
    WinShell class >> layoutDebuggerPane: content [ ^self ]
    WinShell class >> debuggerPaneHwnd [ ^0 ]
