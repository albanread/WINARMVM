"68_winui_sounded_tests.mst — WinUiSoundEditorTests, the headless half of
 WG13's Sound Editor (world/121_winui_sounded.mst).

 THE WHOLE DISPLAY IS CHECKABLE HERE, which is the point of having built it
 as pure methods: `soundRows` is a list over the document, `soundShow:` and
 `soundBarFor:` are functions of a value and its range, and
 `soundDisplayRows` is a function of those. None of them touches a window, an
 audio device or the primary — so what the pane would show is provable on any
 machine this suite runs on, including one with no sound card.

 WHAT IS DELIBERATELY NOT HERE: that a key reaches the pane, that the audition
 makes a noise, and that a saved sheet lands in the image. The first needs a
 real window, the second needs ears (see `docs/SPRINTS.md` W12 — both the
 endpoint peak meter and XAudio2's own SamplesPlayed read zero while sound
 was plainly audible), and the third is `WinHost persistClass:`'s own test.

 LOADING: `WinShell` and `SoundDoc` come from the winui layer and the world
 list respectively; tests.list names ../121 above this file."

TestCase subclass: WinUiSoundEditorTests [
    WinUiSoundEditorTests class >> isEnabled ^ <Boolean> [
        ^Smalltalk platformName == #windows
    ]

    runAll [
        self runTest: #testRowsCoverEveryRecipeFieldAndEveryLiveOscillator
             do: [ self testRowsCoverEveryRecipeFieldAndEveryLiveOscillator ].
        self runTest: #testRowsGrowAndShrinkWithTheOscillatorStack
             do: [ self testRowsGrowAndShrinkWithTheOscillatorStack ].
        self runTest: #testEveryFieldReadsItsOwnValueBack
             do: [ self testEveryFieldReadsItsOwnValueBack ].
        self runTest: #testANudgeMovesOneHundredthOfTheRange
             do: [ self testANudgeMovesOneHundredthOfTheRange ].
        self runTest: #testTheDocumentClampsRatherThanTheFace
             do: [ self testTheDocumentClampsRatherThanTheFace ].
        self runTest: #testTheBarTracksThePositionInTheRange
             do: [ self testTheBarTracksThePositionInTheRange ].
        self runTest: #testUnitsAreReadBackWithTheNumber
             do: [ self testUnitsAreReadBackWithTheNumber ].
        self runTest: #testDisplayRowsAreAsciiAndMarkTheSelection
             do: [ self testDisplayRowsAreAsciiAndMarkTheSelection ].
        self runTest: #testEveryPresetLoadsAndRoundTripsThroughParams
             do: [ self testEveryPresetLoadsAndRoundTripsThroughParams ].
        ^self
    ]

    "── the row list ────────────────────────────────────────────────────"

    testRowsCoverEveryRecipeFieldAndEveryLiveOscillator [
        "Thirteen recipe fields, then four per oscillator. A fresh document has
         one oscillator, so seventeen rows — and the count is asserted rather
         than the list, because a field silently dropped is the failure this
         guards and a missing row would not otherwise show."
        WinShell soundNew.
        self assert: WinShell soundFields size equals: 13
             description: 'thirteen recipe fields'.
        self assert: WinShell soundRows size equals: 17
             description: '13 recipe + 4 for the one oscillator'.
    ]

    testRowsGrowAndShrinkWithTheOscillatorStack [
        WinShell soundNew.
        WinShell soundDoc addOsc.
        self assert: WinShell soundRows size equals: 21
             description: 'a second oscillator adds four rows'.
        WinShell soundDoc removeOsc.
        self assert: WinShell soundRows size equals: 17
             description: 'and removing it takes them away again'.
    ]

    "── values ─────────────────────────────────────────────────────────"

    testEveryFieldReadsItsOwnValueBack [
        "Set each field to a value inside its own range, then read it back
         through the same accessor pair. A get/set pair wired to the wrong
         document field would pass a test of one field and fail here."
        | rows field lo hi mid |
        WinShell soundNew.
        rows := WinShell soundRows.
        1 to: rows size do: [ :i |
            field := rows at: i.
            lo := field at: 4.
            hi := field at: 5.
            mid := lo + ((hi - lo) / 2).
            (field at: 1) == #oscWave ifTrue: [ mid := 2 ].
            (field at: 2) == #echoCount ifTrue: [ mid := 4 ].
            (field at: 2) == #seed ifTrue: [ mid := 1234 ].
            WinShell soundSet: field to: mid.
            self assert: ((WinShell soundValueOf: field) - mid) abs < 0.001
                 description: (field at: 3) , ' reads back what was written' ].
    ]

    testANudgeMovesOneHundredthOfTheRange [
        "The step is derived from the range and nothing else — there is no
         step column to disagree with the bounds."
        | field before after |
        WinShell soundNew.
        field := WinShell soundFields at: 4.       "sustain, 0.0 .. 1.0"
        WinShell soundSet: field to: 0.5.
        before := WinShell soundValueOf: field.
        WinShell soundSelect: 4.
        WinShell soundNudge: 1.
        after := WinShell soundValueOf: field.
        self assert: (after - before - 0.01) abs < 0.0001
             description: 'right nudges a hundredth of 0..1'.
    ]

    testTheDocumentClampsRatherThanTheFace [
        "Section 3's rule read from this end: the face never truncates, so a
         nudge past a bound stops where the DOCUMENT says, not where the face
         happens to draw."
        | field |
        WinShell soundNew.
        field := WinShell soundFields at: 4.       "sustain, clamps at 1.0"
        WinShell soundSet: field to: 99.0.
        self assert: (WinShell soundValueOf: field) equals: 1.0
             description: 'the document clamps sustain to 1.0'.
        WinShell soundSet: field to: 0 - 5.
        self assert: (WinShell soundValueOf: field) equals: 0.0
             description: 'and to 0.0 at the bottom'.
    ]

    "── the display ────────────────────────────────────────────────────"

    testTheBarTracksThePositionInTheRange [
        | field |
        WinShell soundNew.
        field := WinShell soundFields at: 4.       "sustain, 0.0 .. 1.0"
        WinShell soundSet: field to: 0.0.
        self assert: (WinShell soundBarFor: field) equals: '....................'
             description: 'an empty bar at the bottom of the range'.
        WinShell soundSet: field to: 1.0.
        self assert: (WinShell soundBarFor: field) equals: '####################'
             description: 'and a full one at the top'.
        WinShell soundSet: field to: 0.5.
        self assert: (WinShell soundBarFor: field) size equals: 20
             description: 'always twenty cells wide'.
    ]

    testUnitsAreReadBackWithTheNumber [
        | rows |
        WinShell soundNew.
        rows := WinShell soundRows.
        self assert: ((WinShell soundShow: (rows at: 1)) endsWith: ' s')
             description: 'duration reads in seconds'.
        self assert: ((WinShell soundShow: (rows at: 6)) endsWith: ' Hz')
             description: 'a sweep reads in hertz'.
        self assert: (WinShell soundShow: (rows at: 14)) equals: 'sine'
             description: 'a wave reads by NAME, not by its index'.
    ]

    testDisplayRowsAreAsciiAndMarkTheSelection [
        "ASCII PER CHARACTER, asserted rather than remembered: a guest String
         is UTF-8 bytes and this grid takes codepoints, so one em-dash arrives
         as three cells of rubbish. The fifth sighting."
        | rows found |
        WinShell soundNew.
        WinShell soundSelect: 3.
        rows := WinShell soundDisplayRows.
        self assert: rows isEmpty not description: 'the pane has something to show'.
        found := false.
        rows do: [ :pair |
            (pair at: 1) do: [ :ch |
                self assert: ch asInteger < 128
                     description: 'every character is ASCII' ].
            ((pair at: 1) startsWith: '> ') ifTrue: [ found := true ] ].
        self assert: found description: 'the selected row is marked'.
    ]

    "── the presets ────────────────────────────────────────────────────"

    testEveryPresetLoadsAndRoundTripsThroughParams [
        "All twelve, through the flat contract and back. `fromParams:` parses
         before it commits, so a preset that produced a malformed list would
         answer false here rather than half-load — and the length check is the
         contract's own arithmetic, 14 + 5 per oscillator."
        | doc params |
        WinShell soundNew.
        doc := WinShell soundDoc.
        0 to: 11 do: [ :i |
            doc loadPreset: i.
            params := doc paramsList.
            self assert: params size equals: 14 + (5 * doc oscCount)
                 description: 'preset ' , i printString , ' has a contract-shaped list'.
            self assert: (doc fromParams: params)
                 description: 'preset ' , i printString , ' round-trips'.
            self assert: doc paramsList equals: params
                 description: 'preset ' , i printString , ' is unchanged by the trip' ].
        self assert: SoundDoc presetNames size equals: 12
             description: 'twelve presets, twelve names'.
    ]
]
