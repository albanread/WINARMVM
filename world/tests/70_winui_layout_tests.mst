"70_winui_layout_tests.mst — WinUiLayoutTests, WG14b's arithmetic gate.

 `world/123_winui_layout.mst` takes a spec, a width and a font's metrics, and
 answers where every control goes. It touches no window, so every rule in it
 is checkable to the pixel — and the assertions below are equalities for that
 reason, not tolerances.

 THE METRICS ARE ROUND ON PURPOSE: 10 pixels a character, 20 a line. Real
 ones are neither, and a test that used them would be asserting the font
 rather than the layout.

 WHAT IS DELIBERATELY NOT HERE: that a control appears where the rect says.
 That needs a window and belongs to the realizer's own gate. What IS here is
 everything the realizer will be TOLD, which is the whole of the geometry."

TestCase subclass: WinUiLayoutTests [
    WinUiLayoutTests class >> isEnabled ^ <Boolean> [
        ^Smalltalk platformName == #windows
    ]

    runAll [
        self runTest: #testAStackFlowsDownByItsGap
             do: [ self testAStackFlowsDownByItsGap ].
        self runTest: #testALabelCostsALineAboveItsControl
             do: [ self testALabelCostsALineAboveItsControl ].
        self runTest: #testARowRunsAcrossAndKeepsNaturalWidths
             do: [ self testARowRunsAcrossAndKeepsNaturalWidths ].
        self runTest: #testARowThatDoesNotFitShrinksToExactlyTheSpace
             do: [ self testARowThatDoesNotFitShrinksToExactlyTheSpace ].
        self runTest: #testShrinkingNeverGoesBelowTheFloor
             do: [ self testShrinkingNeverGoesBelowTheFloor ].
        self runTest: #testAGridFillsRowMajorInUniformColumns
             do: [ self testAGridFillsRowMajorInUniformColumns ].
        self runTest: #testACardIgnoresPaddingAndReservesItsTitle
             do: [ self testACardIgnoresPaddingAndReservesItsTitle ].
        self runTest: #testEveryPlacementIsInsideTheWindow
             do: [ self testEveryPlacementIsInsideTheWindow ].
        self runTest: #testAPaneAsksForItsOwnSize
             do: [ self testAPaneAsksForItsOwnSize ].
        ^self
    ]

    "── helpers ─────────────────────────────────────────────────────────"

    metrics ^ <Array> [
        ^WinSpecLayout metricsCharWidth: 10 lineHeight: 20
    ]

    "Placements for `body` laid out in a 400-wide window."
    place: body <WinNode> ^ <OrderedCollection> [
        ^WinSpecLayout
            layout: (WinSpec window: 'W' id: #w body: body)
            width: 400
            metrics: self metrics
    ]

    "The one placement of kind `aKind` whose node has id `anId`."
    in: places <OrderedCollection> find: anId <String> kind: aKind <Symbol> ^ <Object> [
        places do: [ :p |
            (((p at: 1) idOrEmpty = anId) and: [ (p at: 6) == aKind ])
                ifTrue: [ ^p ] ].
        ^nil
    ]

    xOf: p <Array> ^ <Integer> [ ^p at: 2 ]
    yOf: p <Array> ^ <Integer> [ ^p at: 3 ]
    wOf: p <Array> ^ <Integer> [ ^p at: 4 ]
    hOf: p <Array> ^ <Integer> [ ^p at: 5 ]

    "── stack ───────────────────────────────────────────────────────────"

    testAStackFlowsDownByItsGap [
        "Root padding 16, so the first child sits at y=16; a text is one line
         tall (20); the default gap is 12; so the second starts at 48."
        | places a b |
        places := self place: (WinSpec stack: {
            WinSpec text: 'one' id: #a.
            WinSpec text: 'two' id: #b } id: #root).
        a := self in: places find: 'a' kind: #control.
        b := self in: places find: 'b' kind: #control.
        self assert: a isNil not description: 'the first child is placed'.
        self assert: (self xOf: a) equals: 16 description: 'inset by the root padding'.
        self assert: (self yOf: a) equals: 16 description: 'and down by it too'.
        self assert: (self hOf: a) equals: 20 description: 'a text is one line'.
        self assert: (self yOf: b) equals: 48
             description: '16 + 20 + a 12 gap, exactly'.
        self assert: (self xOf: b) equals: 16
             description: 'a stack does not indent as it goes'.
    ]

    testALabelCostsALineAboveItsControl [
        "The label rule, which four control types share: a STATIC above, then
         a gap of 8, then the control."
        | places lab ctl |
        places := self place: (WinSpec stack: {
            WinSpec input: 'Name' value: 'Ada' event: #e id: #f } id: #root).
        lab := self in: places find: 'f' kind: #label.
        ctl := self in: places find: 'f' kind: #control.
        self assert: lab isNil not description: 'a labelled control gets TWO placements'.
        self assert: (self yOf: lab) equals: 16 description: 'the label is on top'.
        self assert: (self hOf: lab) equals: 20 description: 'and is one line tall'.
        self assert: (self yOf: ctl) equals: 44
             description: '16 + 20 + the 8-pixel label gap'.
        self assert: ((lab at: 1) == (ctl at: 1))
             description: 'both carry the same node - the KIND tells them apart'.
    ]

    "── row ─────────────────────────────────────────────────────────────"

    testARowRunsAcrossAndKeepsNaturalWidths [
        "Two short buttons in 368 available pixels: they fit, so neither is
         stretched. No stretch-to-fill is the rule that surprises people."
        | places a b |
        places := self place: (WinSpec row: {
            WinSpec button: 'ab' event: #x id: #a.
            WinSpec button: 'cd' event: #y id: #b } id: #root).
        a := self in: places find: 'a' kind: #control.
        b := self in: places find: 'b' kind: #control.
        self assert: (self yOf: a) equals: (self yOf: b)
             description: 'a row shares one baseline'.
        self assert: (self xOf: a) equals: 16 description: 'the first is at the left'.
        self assert: (self wOf: a) equals: 48
             description: 'two characters at 10 plus the 28 of a button'.
        self assert: (self xOf: b) equals: 76
             description: '16 + 48 + the 12 gap, and no stretching'.
    ]

    testARowThatDoesNotFitShrinksToExactlyTheSpace [
        "Four wide buttons in 368: they cannot fit, so they scale down — and
         the shaving step means the total is EXACTLY the space, never one or
         two pixels over from the rounding."
        | places total last |
        places := self place: (WinSpec row: {
            WinSpec button: 'a wide caption' event: #x id: #a.
            WinSpec button: 'another wide one' event: #y id: #b.
            WinSpec button: 'and a third here' event: #z id: #c } id: #root).
        total := 0.
        #('a' 'b' 'c') do: [ :each |
            total := total + (self wOf: (self in: places find: each kind: #control)) ].
        self assert: total + 24 <= 368
             description: 'three widths and two gaps fit the 368 available'.
        last := self in: places find: 'c' kind: #control.
        self assert: (self xOf: last) + (self wOf: last) <= 384
             description: 'and the last one ends inside the window'.
    ]

    testShrinkingNeverGoesBelowTheFloor [
        "Eight children cannot each have 72 pixels in 368, and the floor wins
         over the fit — which is deliberate: unreadable is worse than clipped."
        | kids places p |
        kids := OrderedCollection new.
        1 to: 8 do: [ :i |
            kids add: (WinSpec button: 'wide caption here' event: #x
                               id: 'b' , i printString) ].
        places := self place: (WinSpec row: kids id: #root).
        1 to: 8 do: [ :i |
            p := self in: places find: 'b' , i printString kind: #control.
            self assert: (self wOf: p) >= 72
                 description: 'no child is squeezed under the floor' ].
    ]

    "── grid ────────────────────────────────────────────────────────────"

    testAGridFillsRowMajorInUniformColumns [
        "Three cells in two columns: the third wraps to a second line, at the
         first column's x."
        | places a b c |
        places := self place: (WinSpec grid: {
            WinSpec text: 'a' id: #a.
            WinSpec text: 'b' id: #b.
            WinSpec text: 'c' id: #c } columns: 2 id: #root).
        a := self in: places find: 'a' kind: #control.
        b := self in: places find: 'b' kind: #control.
        c := self in: places find: 'c' kind: #control.
        self assert: (self yOf: a) equals: (self yOf: b)
             description: 'the first two share a row'.
        self assert: (self xOf: b) > (self xOf: a)
             description: 'and the second is further right'.
        self assert: (self yOf: c) > (self yOf: a)
             description: 'the third wrapped'.
        self assert: (self xOf: c) equals: (self xOf: a)
             description: 'back to the first column'.
    ]

    "── card ────────────────────────────────────────────────────────────"

    testACardIgnoresPaddingAndReservesItsTitle [
        "A card's padding and gap are FIXED at 12 and 10 whatever the spec
         says — wingui's own behaviour, and a spec that sets them is quietly
         wrong, so the test states it rather than leaving it to be discovered."
        | places title first |
        places := self place: ((WinSpec card: 'Frame' children: {
            WinSpec text: 'inside' id: #a } id: #c)
                at: #padding put: 99; yourself).
        title := self in: places find: 'c' kind: #cardTitle.
        first := self in: places find: 'a' kind: #control.
        self assert: title isNil not description: 'a titled card places its title'.
        self assert: (self xOf: title) equals: 28
             description: '16 root + 12 card padding, NOT the 99 asked for'.
        self assert: (self yOf: first) equals: 54
             description: '16 + 12 padding + 26 reserved for the title'.
    ]

    "── the window ──────────────────────────────────────────────────────"

    testEveryPlacementIsInsideTheWindow [
        "The property that matters most and is easiest to lose: nothing is
         ever placed off the left or above the top, and nothing runs past the
         right edge."
        | places |
        places := self place: (WinSpec stack: {
            WinSpec heading: 'Title' id: #h.
            WinSpec row: {
                WinSpec button: 'One' event: #a id: #b1.
                WinSpec button: 'Two' event: #b id: #b2 } id: #r.
            WinSpec card: 'Box' children: {
                WinSpec input: 'Name' value: '' event: #e id: #f.
                WinSpec checkbox: 'On' checked: true event: #t id: #cb } id: #card } id: #root).
        self assert: places isEmpty not description: 'something was placed'.
        places do: [ :p |
            self assert: (self xOf: p) >= 0 description: 'never off the left'.
            self assert: (self yOf: p) >= 0 description: 'never above the top'.
            self assert: (self wOf: p) > 0 description: 'never zero-width'.
            self assert: (self hOf: p) > 0 description: 'never zero-height'.
            self assert: (self xOf: p) + (self wOf: p) <= 400
                 description: 'and never past the right edge' ].
    ]

    testAPaneAsksForItsOwnSize [
        "A pane is not text and does not get measured like it — it says how
         big it is, because what it shows is pixels the guest computed."
        | places p |
        places := self place: (WinSpec stack: {
            WinSpec indexedPane: #grid width: 300 height: 120 } id: #root).
        p := self in: places find: 'grid' kind: #control.
        self assert: (self wOf: p) equals: 300 description: 'the width it asked for'.
        self assert: (self hOf: p) equals: 120 description: 'and the height'.
    ]
]
