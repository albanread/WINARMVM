"81_clock_completion.mst — `Date today` and `Time now`.

 The census's most surprising hole: the WALL CLOCK was already there —
 world/30 reaches real Unix-epoch milliseconds through
 clock_gettime(CLOCK_REALTIME) over FFI — and `Date` could be built from a
 day/month/year while `Time` could be built from seconds. What was missing
 was the layer between them, so nothing in the image could answer *what day
 is it*. `Date today` and `Time now` were both doesNotUnderstand.

 Two pieces fill it.

 **The calendar arithmetic is pure Smalltalk** — Howard Hinnant's
 civil_from_days/days_from_civil, exact integer arithmetic with no lookup
 tables, correct for any proleptic-Gregorian date including leap centuries
 and dates before the epoch. Hinnant writes the era division defensively
 because C's `/` truncates toward zero; Smalltalk's `//` already floors, so
 the guarded form collapses to a plain `//` here — the one deliberate
 departure from the published algorithm, and the reason the tests below
 check dates on both sides of 1970.

 **The UTC offset comes from the platform**, not from arithmetic: only
 localtime_r knows this machine's zone and whether daylight saving is in
 effect today. It is read from `struct tm`'s tm_gmtoff, whose layout was
 PROBED on this machine rather than assumed (the discipline world/30 set
 when it chose timespec over timeval): a C probe compiled against these
 headers reports sizeof(struct tm) = 56 with tm_gmtoff at offset 40, size 8.
 Being a full 8-byte long at a naturally aligned offset is what makes it
 readable with the `signedLongAt:` that Alien already exposes — the 4-byte
 int fields beside it are exactly the accessor width world/30 recorded as
 missing, which is why this file reads the offset and does the rest itself
 rather than lifting y/m/d straight out of the struct."

Object subclass: Time [
    <classVars: TmBuffer>

    "── epoch access ─────────────────────────────────────────────────────"

    Time class >> secondsSinceEpoch ^ <Integer> [
        "Seconds since 1970-01-01T00:00:00Z. UTC, like the clock it reads."
        ^self millisecondClockValue // 1000
    ]

    "A scratch region for the platform's zone query. mmap'd (macOS) or
     VirtualAlloc'd (Windows) for the same reason world/30's clock buffer
     is — memory handed OUT to native code as a pointer must live outside
     the GC heap, where it can never move mid-call. Allocated once, reused
     forever. macOS needs 64 bytes (an 8-byte time_t then the 56-byte
     struct tm); Windows needs 172 (TIME_ZONE_INFORMATION) — each arm
     allocates its own platform's size."
    Time class >> tmBufferAddress ^ <Integer> [
        TmBuffer isNil ifTrue: [
            Smalltalk platformName == #windows
                ifTrue: [
                    "WINARM (P5, sprint_p05_detail.md D4): kernel32
                     VirtualAlloc — MEM_COMMIT|MEM_RESERVE=12288 (0x3000),
                     PAGE_READWRITE=4, the values world/tests/30's capstone
                     already proves end to end."
                    TmBuffer := self winVirtualAllocAddr: 0 size: 4096 type: 12288 protect: 4 ]
                ifFalse: [
                    "PROT_READ|PROT_WRITE=3, MAP_PRIVATE|MAP_ANON=4098 — the
                     real macOS/arm64 flag values world/30 already proves."
                    TmBuffer := self ffiMmapAddr: 0 length: 64 prot: 3 flags: 4098 fd: -1 offset: 0 ] ].
        ^TmBuffer
    ]
    Time class >> ffiLocaltimeR: timePtr <Integer> tm: tmPtr <Integer> [
        <primitive: FFI function: #localtime_r ret: #g args: #(g g)>
    ]
    "WINARM (P5): the Windows twins. localtime_r does not exist in the UCRT
     and struct tm there carries no tm_gmtoff at all — the zone query is
     kernel32's GetTimeZoneInformation instead (fixed-arity, one pointer)."
    Time class >> winVirtualAllocAddr: a1 <Integer> size: a2 <Integer> type: a3 <Integer> protect: a4 <Integer> [
        <primitive: FFI function: #VirtualAlloc ret: #g args: #(g g g g)>
    ]
    Time class >> ffiGetTimeZoneInformation: tzPtr <Integer> [
        <primitive: FFI function: #GetTimeZoneInformation ret: #g args: #(g)>
    ]

    "This machine's offset from UTC right now, in seconds — POSITIVE east of
     Greenwich, and already including daylight saving, because localtime_r
     resolves the zone for the INSTANT it is given. Answers 0 if the call
     fails, so a clock question can never be the thing that raises."
    Time class >> localOffsetSeconds ^ <Integer> [
        | addr buf |
        Smalltalk platformName == #windows ifTrue: [ ^self winLocalOffsetSeconds ].
        addr := self tmBufferAddress.
        addr isNil ifTrue: [ ^0 ].
        buf := Alien forAddress: addr size: 64.
        "time_t at offset 0 (1-based byte 1); struct tm at offset 8."
        buf signedLongAt: 1 put: self secondsSinceEpoch.
        self ffiLocaltimeR: addr tm: addr + 8.
        "tm_gmtoff: offset 40 within struct tm, so 8 + 40 = 48 from the base;
         1-based byte 49."
        ^buf signedLongAt: 49
    ]

    "WINARM (P5, D4): the Windows offset arm. GetTimeZoneInformation fills a
     TIME_ZONE_INFORMATION and its RETURN says which bias is active NOW
     (0 = no DST rule, 1 = standard, 2 = daylight; 4294967295 = failed).
     UTC = local + Bias(+ActiveBias) MINUTES, so local-east-positive seconds
     is the negated sum times 60. Struct offsets Bias@0, StandardBias@84,
     DaylightBias@168 come from winkb (windows_api.db struct_fields) and are
     pinned against the live DB by runtime::winkb's real-DB test — probed,
     not assumed, the same discipline the tm_gmtoff arm above records."
    Time class >> winLocalOffsetSeconds ^ <Integer> [
        | addr buf ret bias active |
        addr := self tmBufferAddress.
        (addr isNil or: [ addr = 0 ]) ifTrue: [ ^0 ].
        buf := Alien forAddress: addr size: 172.
        ret := self ffiGetTimeZoneInformation: addr.
        ret = 4294967295 ifTrue: [ ^0 ].
        bias := self winI32Of: buf at: 0.
        active := ret = 2
            ifTrue: [ self winI32Of: buf at: 168 ]
            ifFalse: [ ret = 1 ifTrue: [ self winI32Of: buf at: 84 ] ifFalse: [ 0 ] ].
        ^(bias + active) * -60
    ]
    "Compose a SIGNED little-endian i32 from Alien bytes (Alien natively
     does 1- and 8-byte only — the exact accessor-width gap world/30
     recorded; the bias fields are 4-byte LONGs, negative east of
     Greenwich). `off` is the 0-based C offset."
    Time class >> winI32Of: anAlien at: off <Integer> ^ <Integer> [
        | v |
        v := (anAlien byteAt: off + 1) + ((anAlien byteAt: off + 2) * 256)
            + ((anAlien byteAt: off + 3) * 65536) + ((anAlien byteAt: off + 4) * 16777216).
        ^v >= 2147483648 ifTrue: [ v - 4294967296 ] ifFalse: [ v ]
    ]

    Time class >> localSecondsSinceEpoch ^ <Integer> [
        "Epoch seconds shifted into local time — the value the local calendar
         and the local clock are both read from, so they can never disagree
         about which side of midnight it is."
        ^self secondsSinceEpoch + self localOffsetSeconds
    ]

    "── the constructors that were missing ───────────────────────────────"

    Time class >> now ^ <Time> [
        "The current LOCAL time of day."
        ^self fromSeconds: self localSecondsSinceEpoch \\ 86400
    ]
    Time class >> nowUTC ^ <Time> [
        ^self fromSeconds: self secondsSinceEpoch \\ 86400
    ]
    Time class >> fromEpochSeconds: epochSeconds <Integer> ^ <Time> [
        "The time-of-day part of an epoch instant. `\\` floors, so a negative
         (pre-1970) instant still lands in 0..86399 rather than going
         negative."
        ^self fromSeconds: epochSeconds \\ 86400
    ]
]

Object subclass: Date [
    "── civil calendar from a day number ─────────────────────────────────
     Hinnant's civil_from_days: exact, table-free, and correct across leap
     centuries. Day 0 is 1970-01-01."

    Date class >> fromEpochDays: epochDays <Integer> ^ <Date> [
        | z era doe yoe y doy mp d m |
        "Shift the epoch to 0000-03-01, which puts the leap day at the END of
         the era and is what makes the rest of this table-free."
        z := epochDays + 719468.
        era := z // 146097.
        doe := z - (era * 146097).
        yoe := (doe - (doe // 1460) + (doe // 36524) - (doe // 146096)) // 365.
        y := yoe + (era * 400).
        doy := doe - ((365 * yoe) + (yoe // 4) - (yoe // 100)).
        mp := ((5 * doy) + 2) // 153.
        d := doy - (((153 * mp) + 2) // 5) + 1.
        m := mp + (mp < 10 ifTrue: [ 3 ] ifFalse: [ -9 ]).
        m <= 2 ifTrue: [ y := y + 1 ].
        ^self newDay: d monthIndex: m year: y
    ]

    "The exact inverse — days_from_civil. Together the two make the
     round-trip testable, which is the only way to be sure of arithmetic
     this dense."
    Date class >> epochDaysForDay: d <Integer> monthIndex: m <Integer> year: y <Integer> ^ <Integer> [
        | yy era yoe doy doe |
        yy := m <= 2 ifTrue: [ y - 1 ] ifFalse: [ y ].
        era := yy // 400.
        yoe := yy - (era * 400).
        doy := ((153 * (m + (m > 2 ifTrue: [ -3 ] ifFalse: [ 9 ]))) + 2) // 5 + d - 1.
        doe := (yoe * 365) + (yoe // 4) - (yoe // 100) + doy.
        ^(era * 146097) + doe - 719468
    ]

    Date class >> today ^ <Date> [
        "The current LOCAL date."
        ^self fromEpochDays: Time localSecondsSinceEpoch // 86400
    ]
    Date class >> todayUTC ^ <Date> [
        ^self fromEpochDays: Time secondsSinceEpoch // 86400
    ]
    Date class >> fromEpochSeconds: epochSeconds <Integer> ^ <Date> [
        "`//` floors, so a pre-1970 instant maps to the day it falls in
         rather than the one after it."
        ^self fromEpochDays: epochSeconds // 86400
    ]

    "── instance protocol the above makes answerable ─────────────────────"

    asEpochDays ^ <Integer> [
        ^Date epochDaysForDay: dayOfMonth monthIndex: monthIndex year: year
    ]
    dayOfWeekIndex ^ <Integer> [
        "1..7 into `Date daysOfWeek`, which starts at Monday. Epoch day 0 —
         1970-01-01 — was a Thursday, which is what fixes the +3."
        ^((self asEpochDays + 3) \\ 7) + 1
    ]
    dayOfWeek ^ <Symbol> [ ^Date nameOfDay: self dayOfWeekIndex ]
    isLeapYear ^ <Boolean> [
        ^(year \\ 4 = 0) and: [ (year \\ 100 ~= 0) or: [ year \\ 400 = 0 ] ]
    ]
    daysInMonth ^ <Integer> [
        | lengths |
        lengths := #(31 28 31 30 31 30 31 31 30 31 30 31).
        (monthIndex = 2 and: [ self isLeapYear ]) ifTrue: [ ^29 ].
        ^lengths at: monthIndex
    ]
    dayOfYear ^ <Integer> [
        ^self asEpochDays - (Date epochDaysForDay: 1 monthIndex: 1 year: year) + 1
    ]
    addDays: n <Integer> ^ <Date> [ ^Date fromEpochDays: self asEpochDays + n ]
    subtractDays: n <Integer> ^ <Date> [ ^self addDays: n negated ]
    subtractDate: aDate <Date> ^ <Integer> [
        "Whole days from aDate to me — negative if aDate is later."
        ^self asEpochDays - aDate asEpochDays
    ]
]
